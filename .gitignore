# Dipendenze
node_modules/
.pnp
.pnp.*

# Build di Next.js
.next/
out/
next-env.d.ts

# Log e cache
*.log
npm-debug.log*
.eslintcache
.turbo/

# Variabili d'ambiente
.env
.env.*
!.env.example

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editor
# I task sono condivisi di proposito: servono a far partire il sito con un comando
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/start-site.ps1
.idea/

# Generati da scripts/optimize-images.mjs
site/public/img/
site/src/content/image-manifest.json

# Presentazione d'esame di Doggo: 587 MB, oltre il limite di 100 MB per file di GitHub.
# Le immagini usate dal sito ne sono state ricavate e stanno in site/assets/img/
Sito/doggo2/*.pdf

# Sorgenti pesanti di The Last of Us (oltre 80 MB l'uno): restano solo in locale
Sito/TLOU/Presentazione/*.key
Sito/TLOU/VISUAL/*.psd

# Sorgenti pesanti di Rikka (brief del docente in PDF e PSD dello stop motion)
Sito/rikka/*.pdf
Sito/rikka/stop motion/*.psd

# Materiale di ricerca di The Last of Us (fotogrammi della serie, texture, articoli): non
# serve al sito e pesa quasi 200 MB. Resta solo in locale
Sito/TLOU/img/
Sito/TLOU/fase di Ricerca/

# Scatti originali del backstage di Oculus (RAW e JPG a piena risoluzione, oltre 100 MB in
# tutto): restano solo in locale. Nell'archivio ne va una copia in JPEG leggero, in
# "Sito/OCULUS/BackStage leggeri/"; quelle usate dal sito stanno in site/assets/img/
Sito/OCULUS/BackStage/
